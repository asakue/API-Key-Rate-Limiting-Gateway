# Gateway Reverse Proxy (Data Plane)
PORT=8000
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/gateway_db?sslmode=disable
DEFAULT_UPSTREAM_URL=http://localhost:8080
L1_CACHE_TTL_SECONDS=60

# Control Plane API
CONTROL_PLANE_PORT=8081
JWT_SECRET=super_secret_production_ready_jwt_key_32chars!
CORS_ORIGIN=*

# Mock Upstream Backend
MOCK_BACKEND_PORT=8080

# Next.js Dashboard UI
NEXT_PUBLIC_CONTROL_PLANE_URL=http://localhost:8081
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000

